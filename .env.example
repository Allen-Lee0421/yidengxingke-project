# 必填：請使用至少 32 字元的隨機值，絕不要提交真實值
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# 生產環境資料庫
DATABASE_URL=postgres://user:password@host:5432/database
DATABASE_SSL=true

# 逗號分隔的正式網站來源；未設定時僅允許同源請求
ALLOWED_ORIGINS=https://xingdeng.tw
TRUST_PROXY=false
NODE_ENV=production

# 以 JSON 放入伺服器環境，不要放進前端或 Git；範例：
# PRIVILEGE_CODES_JSON={"random-code":{"level":9,"name":"最高管理員"}}
PRIVILEGE_CODES_JSON={}

# 名單匯出用獨立長隨機 token
ADMIN_EXPORT_TOKEN=replace-with-another-random-secret
